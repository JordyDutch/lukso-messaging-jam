# Copy to .env.local and fill in once the pieces exist.

# RegistryV3 address (deploy frontend/contracts/RegistryV3.sol first).
# If unset, the app falls back to the lab RegistryV2 (announce works; WebRTC
# session signaling is gated off with an honest banner).
# VITE_REGISTRY_ADDRESS=0x...

# Off-chain sealed-SDP blob store (IPFS). If unset, an in-memory stub is used
# (works in one browser / tests only — NOT networked).
# VITE_IPFS_PUT_URL=https://your-pinning-endpoint/add
# VITE_IPFS_GATEWAY=https://ipfs.io
